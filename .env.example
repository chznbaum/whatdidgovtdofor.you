# Copy to .env (gitignored) and fill in. The pipeline loads it automatically; shell variables win.

# Congress.gov API key, free at https://api.data.gov/signup/ (without it the us-laws feed uses the rate-limited DEMO_KEY)
CONGRESS_API_KEY=
# NY Senate Open Legislation API key, free at https://legislation.nysenate.gov/ (enables the ny-laws feed)
NYSENATE_API_KEY=
# NYC Council Legistar Web API token, free at https://council.nyc.gov/legislation/api/ (enables the nyc-laws feed)
NYC_LEGISTAR_TOKEN=

# Optional model overrides (defaults in README.md)
# CLAUDE_MODEL=
# TRIAGE_MODEL=
# CODEX_MODEL=
# CODEX_EFFORT=
