<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs ops/daily.sh every morning at 6:00. Not installed by default. To install:
    cp ops/com.whatdidgovtdofor.pipeline.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.whatdidgovtdofor.pipeline.plist
  Edit the two paths below first if the repo or Node live elsewhere.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.whatdidgovtdofor.pipeline</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/chazona/Repos/community/whatdidgovtdofor.you/ops/daily.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/chazona/.local/share/nvm/v24.11.1/bin:/Users/chazona/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/whatdidgovtdofor-pipeline.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/whatdidgovtdofor-pipeline.log</string>
</dict>
</plist>
