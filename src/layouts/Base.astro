---
import '../styles/global.css';
import CallToAction from '../components/CallToAction.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  // The call to action above the footer. Off on the page it points to.
  cta?: boolean;
  footer?: boolean;
  noindex?: boolean;
}


const SITE = 'What did government do for you?';
const {
  title,
  description = 'The concrete things government did for people, who made them happen, and whether they still stand.',
  // Pages without their own share image use the site's: the home page's question and lead person.
  image = '/og/home.png',
  cta = true,
  footer = true,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} | whatdidgovtdofor.you` : `${SITE} | whatdidgovtdofor.you`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://whatdidgovtdofor.you');
const ogImage = image ? new URL(image, canonical) : undefined;
const path = Astro.url.pathname;
const nav = [
  { href: '/actions/', label: 'Actions' },
  { href: '/places/', label: 'Places' },
  { href: '/how-we-check/', label: 'How we check', wide: true },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="whatdidgovtdofor.you" href="/feed.xml" />
    <meta name="theme-color" content="#ff7a00" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="whatdidgovtdofor.you" />
    <meta property="og:title" content={title ?? SITE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {noindex && <meta name="robots" content="noindex" />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="bar">
      <div class="bar-in">
        <a class="mark" href="/">whatdidgovtdofor.you</a>
        <nav aria-label="Site">
          <ul>
            {
              nav.map((n) => (
                <li class:list={[n.wide && 'wide']}>
                  <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    {cta && <CallToAction />}
    {footer && <SiteFooter />}
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 10;
    padding: 0.6rem 0.9rem;
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
  }
  .skip:focus {
    top: 0.5rem;
  }

  /* The bar is orange so it runs straight into an orange cover. */
  .bar {
    position: relative;
    z-index: 5;
    background: var(--orange);
  }
  .bar-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0 1rem;
    width: min(100% - 2 * var(--gutter), var(--page));
    margin-inline: auto;
    min-height: 3.5rem;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font: 800 1.0625rem/1 var(--text);
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  nav ul {
    display: flex;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.55rem;
    font: 600 1rem/1 var(--text);
    text-decoration: none;
  }
  nav li:last-child a {
    padding-right: 0;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .wide {
    display: none;
  }
  @media (min-width: 40rem) {
    .wide {
      display: block;
    }
  }
  @media (min-width: 60rem) {
    .bar-in {
      min-height: 4.5rem;
    }
    .mark {
      font-size: 1.25rem;
    }
    nav a {
      font-size: 1.0625rem;
      padding: 0 0.9rem;
    }
  }

  main {
    display: block;
    min-height: 60vh;
    /* Space before whatever ends the page: the call to action, or the footer. */
    padding-bottom: 5rem;
  }

</style>
