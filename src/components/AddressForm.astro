---
// Address lookup. The address goes to /you/ in the URL fragment, which browsers never send to a server.
interface Props {
  id?: string;
  value?: string;
}
const { id = 'address' } = Astro.props;
---

<form class="lookup" action="/you/" method="get" data-lookup>
  <label for={id}>Your street address</label>
  <div class="field">
    <input
      id={id}
      name="address"
      type="text"
      autocomplete="street-address"
      placeholder="810 Union St, Norfolk, VA"
      required
      aria-describedby={`${id}-hint`}
    />
    <button type="submit">Show me</button>
  </div>
  <p class="hint" id={`${id}-hint`}>
    We find your districts with the U.S. Census Bureau's address lookup. We don't save your address.
  </p>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-lookup]')) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const address = new FormData(form).get('address')?.toString().trim();
      if (!address) return;
      const target = `/you/#${encodeURIComponent(address)}`;
      if (location.pathname === '/you/') {
        location.hash = encodeURIComponent(address);
      } else {
        location.href = target;
      }
    });
  }
</script>

<style>
  .lookup {
    display: grid;
    gap: 0.5rem;
  }
  label {
    font-weight: 700;
    font-size: var(--t-md);
  }
  .field {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  input {
    flex: 1 1 16rem;
    min-width: 0;
    padding: 0.85rem 1rem 0.7rem;
    border: 3px solid currentColor;
    border-radius: 8px;
    background: var(--paper);
    color: var(--ink);
    font: 600 var(--t-md) / 1.2 var(--sans);
  }
  input::placeholder {
    color: var(--steel);
    font-weight: 500;
  }
  button {
    flex: 0 0 auto;
    padding: 0.85rem 1.4rem 0.7rem;
    border: 3px solid currentColor;
    border-radius: 8px;
    background: var(--ink);
    color: var(--paper);
    font: 800 var(--t-md) / 1.2 var(--sans);
    cursor: pointer;
  }
  button:hover {
    background: var(--paper);
    color: var(--ink);
  }
  .hint {
    font-size: var(--t-sm);
    font-weight: 500;
    opacity: 0.92;
  }
</style>
