---
// Address lookup. The address goes to /you/ in the URL fragment, which browsers never send to a server.
interface Props {
  id?: string;
  value?: string;
}
const { id = 'address' } = Astro.props;
---

<form class="lookup" action="/you/" method="get" data-lookup>
  <label for={id}>Who did something for your address?</label>
  <div class="field">
    <input
      id={id}
      name="address"
      type="text"
      autocomplete="street-address"
      placeholder="810 Union St, Norfolk, VA"
      required
      aria-describedby={`${id}-hint`}
    />
    <button type="submit">Show me who</button>
  </div>
  <p class="hint" id={`${id}-hint`}>
    We look up your districts with the U.S. Census Bureau. We don't save your address.
  </p>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-lookup]')) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const address = new FormData(form).get('address')?.toString().trim();
      if (!address) return;
      const target = `/you/#${encodeURIComponent(address)}`;
      if (location.pathname === '/you/') {
        location.hash = encodeURIComponent(address);
      } else {
        location.href = target;
      }
    });
  }
</script>

<style>
  .lookup {
    display: grid;
    gap: 0.6rem;
  }
  label {
    font-weight: 700;
    font-size: 1.0625rem;
  }
  .field {
    display: flex;
    border: 3px solid currentColor;
  }
  input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 3.25rem;
    padding: 0 0.75rem;
    border: 0;
    border-radius: 0;
    background: var(--paper);
    color: var(--ink);
    font: 500 1.0625rem / 1.2 var(--text);
  }
  input::placeholder {
    color: #595959;
  }
  button {
    flex: 0 0 auto;
    min-height: 3.25rem;
    padding: 0 1rem;
    border: 0;
    border-radius: 0;
    background: var(--ink);
    color: var(--paper);
    font: 700 1.0625rem / 1 var(--text);
    cursor: pointer;
  }
  :global(.on-ink) button {
    background: var(--orange);
    color: var(--ink);
  }
  button:hover {
    text-decoration: underline;
  }
  .hint {
    font-size: 1rem;
  }
</style>
