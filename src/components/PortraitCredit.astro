---
// The label every drawing carries, and a link to the page each source photo came from. The site never republishes
// the photo itself (pipeline/portraits/SOURCING.md). Labels are truthful: "official portrait" only for an official
// government portrait (Congress bioguide); otherwise "photo".
import type { Official } from '../lib/data.ts';

interface Props {
  // The people pictured. Anyone without a drawing is skipped.
  people: Official[];
  class?: string;
}

const { people, class: cls } = Astro.props;
const drawn = people.filter((o) => o.data.portrait);
const many = drawn.length > 1;
const allOfficial = drawn.every((o) => o.data.portrait!.kind === 'official');
const label = many
  ? `Illustrations from ${allOfficial ? 'official portraits' : 'photos'}.`
  : `Illustration from ${allOfficial ? 'official portrait' : 'photo'}.`;
const lastName = (n: string) => n.split(' ').at(-1);
---

{
  drawn.length > 0 && (
    <p class:list={['credit', cls]}>
      <span>{label}</span>
      {drawn.map((o) => {
        const s = o.data.portrait!.source;
        return (
          <span class="src">
            <a href={s.url} target="_blank" rel="noopener">
              See the photo{many && ` of ${lastName(o.data.name)}`} ({s.label})
              <span class="visually-hidden">, opens in a new tab</span>
            </a>
            {s.license && <span class="license">{s.license}.</span>}
          </span>
        );
      })}
    </p>
  )
}

<style>
  .credit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.9rem;
    font: 500 1rem/1.3 var(--text);
  }
  .src {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.5rem;
  }
  .src a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    text-underline-offset: 3px;
  }
</style>
