---
// One government action as a road sign. Color = status; exit tab = the government that acted;
// the supplemental plaque underneath qualifies the status. See docs/design.md.
import { getEntry } from 'astro:content';
import type { Entry } from '../lib/data.ts';
import { entryUrl } from '../lib/data.ts';
import { ROLE_BYLINE, nameWithParty, primaryCredit } from '../lib/format.ts';
import { TONE, plaqueText } from '../lib/status.ts';

interface Props {
  entry: Entry;
  size?: 'compact' | 'full';
  heading?: 'h2' | 'h3';
  link?: boolean;
}

const { entry, size = 'compact', heading = 'h3', link = size === 'compact' } = Astro.props;
const d = entry.data;
const tone = TONE[d.status.state];
const place = await getEntry(d.jurisdiction);
const credit = primaryCredit(d.credit);
const official = await getEntry(credit.official);
const byline = official ? `${ROLE_BYLINE[credit.role]} ${nameWithParty(official.data)}` : undefined;
const H = heading;
---

<div class="post" data-size={size}>
  <article class="sign" data-tone={tone}>
    <span class="tab" title={place?.data.name}><span>{place?.data.short}</span></span>
    <div class="face">
      <H class="legend">
        {link ? <a href={entryUrl(entry)}>{d.title}</a> : d.title}
      </H>
      {
        size === 'full' && (
          <dl class="ledger">
            {d.impact.map((i) => (
              <div class="row">
                <dt>{i.label}</dt>
                <dd class="num">{i.figure}</dd>
              </div>
            ))}
          </dl>
        )
      }
      {byline && <p class="byline">{byline}</p>}
    </div>
  </article>
  <p class="plaque" data-tone={tone}><span>{plaqueText(d)}</span></p>
</div>

<style>
  .post {
    --pad: 5px;
    --radius: 14px;
    --border: 3px;
    padding-top: 1.9rem; /* room for the exit tab */
  }
  .post[data-size='full'] {
    --pad: 8px;
    --radius: 22px;
    --border: 5px;
    padding-top: 2.6rem;
  }

  [data-tone='guide'] {
    --bg: var(--guide);
    --fg: var(--paper);
  }
  [data-tone='work'] {
    --bg: var(--work);
    --fg: var(--ink);
  }
  [data-tone='warning'] {
    --bg: var(--warning);
    --fg: var(--ink);
  }
  [data-tone='stop'] {
    --bg: var(--stop);
    --fg: var(--paper);
  }

  .sign {
    position: relative;
    padding: var(--pad);
    background: var(--bg);
    color: var(--fg);
    border-radius: var(--radius);
  }
  .sign:has(a:focus-visible) {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
    box-shadow: 0 0 0 6px var(--warning);
  }
  .sign[data-tone='warning']:has(a:focus-visible) {
    box-shadow: 0 0 0 6px var(--paper);
  }

  .face {
    border: var(--border) solid var(--fg);
    border-radius: calc(var(--radius) - var(--pad));
    padding: 1rem 1.25rem 1.1rem;
  }
  [data-size='full'] .face {
    padding: clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 4vw, 2.5rem) clamp(1.25rem, 3vw, 1.75rem);
  }

  /* Exit tab: a small panel riding the top edge, open at the bottom. */
  .tab {
    position: absolute;
    right: 1.25rem;
    bottom: 100%;
    padding: var(--pad) var(--pad) 0;
    background: var(--bg);
    border-radius: calc(var(--radius) * 0.6) calc(var(--radius) * 0.6) 0 0;
  }
  .tab span {
    display: block;
    padding: 0.2rem 0.6rem 0.1rem;
    border: var(--border) solid var(--fg);
    border-bottom: 0;
    border-radius: calc(var(--radius) * 0.6 - var(--pad)) calc(var(--radius) * 0.6 - var(--pad)) 0 0;
    font-weight: 800;
    font-size: var(--t-xs);
    line-height: 1.2;
    white-space: nowrap;
  }
  [data-size='full'] .tab span {
    font-size: var(--t-md);
    padding: 0.25rem 0.9rem 0.1rem;
  }

  .legend {
    font-weight: 700;
    font-size: var(--t-lg);
    line-height: 1.08;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }
  [data-size='full'] .legend {
    font-size: clamp(var(--t-xl), 6vw, var(--t-3xl));
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .legend a {
    text-decoration: none;
  }
  .legend a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  .sign:hover .legend a {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  /* Impact figures laid out like a distance sign: what on the left, how much on the right. */
  .ledger {
    display: grid;
    gap: 0.55rem;
    margin: 1.4rem 0 0;
    padding-top: 1.1rem;
    border-top: var(--border) solid var(--fg);
  }
  .row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 1.5rem;
  }
  .row dt::first-letter {
    text-transform: uppercase;
  }
  .row dt {
    font-weight: 600;
    font-size: var(--t-md);
    line-height: 1.2;
  }
  .row dd {
    margin: 0;
    font-weight: 800;
    font-size: clamp(var(--t-lg), 4vw, var(--t-2xl));
    line-height: 1;
    letter-spacing: -0.02em;
    text-align: right;
  }

  .byline {
    margin-top: 0.7rem;
    font-weight: 600;
    font-size: var(--t-sm);
  }
  [data-size='full'] .byline {
    margin-top: 1.25rem;
    font-size: var(--t-md);
  }

  /* Supplemental plaque: same colors as the sign, mounted just below it. */
  .plaque {
    display: table;
    margin-top: 6px;
    padding: calc(var(--pad) - 1px);
    background: var(--bg);
    color: var(--fg);
    border-radius: calc(var(--radius) * 0.6);
  }
  .plaque span {
    display: block;
    padding: 0.25rem 0.7rem 0.15rem;
    border: calc(var(--border) - 1px) solid var(--fg);
    border-radius: calc(var(--radius) * 0.6 - var(--pad) + 1px);
    font-weight: 700;
    font-size: var(--t-xs);
  }
  [data-size='full'] .plaque span {
    font-size: var(--t-sm);
    padding: 0.35rem 0.9rem 0.2rem;
  }

  @media (max-width: 30rem) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    .row dd {
      order: -1;
      text-align: left;
    }
  }
</style>
