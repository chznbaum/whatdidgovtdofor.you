---
import Sign from './Sign.astro';
import { entryPlaceIds, type Entry } from '../lib/data.ts';
import { TONE } from '../lib/status.ts';

interface Props {
  entries: Entry[];
  heading?: 'h2' | 'h3';
  // Optional line under each sign, keyed by entry id (e.g. an official's role).
  captions?: Map<string, string>;
}

const { entries, heading = 'h3', captions } = Astro.props;
---

<ul class="grid" role="list">
  {
    entries.map((entry) => (
      <li
        data-entry={entry.id}
        data-places={entryPlaceIds(entry).join(' ')}
        data-tone={TONE[entry.data.status.state]}
        data-level={entry.data.level}
        data-topics={entry.data.topics.join(' ')}
      >
        <Sign entry={entry} heading={heading} />
        {captions?.get(entry.id) && <p class="caption">{captions.get(entry.id)}</p>}
      </li>
    ))
  }
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    align-items: start;
    gap: 1.75rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .caption {
    margin-top: 0.5rem;
    font-weight: 700;
    font-size: var(--t-sm);
  }
</style>
