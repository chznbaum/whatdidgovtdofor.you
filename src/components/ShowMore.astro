---
// The button under a list that adds the next batch of cards (the list's own script loads them). The outlined
// button style is shared (.button in global.css); this only places it.
interface Props {
  hidden?: boolean;
}
const { hidden = true } = Astro.props;
---

<button class="more button" type="button" data-more hidden={hidden}>Show more</button>

<style>
  .more {
    display: block;
    margin: 3rem auto 0;
  }
</style>
