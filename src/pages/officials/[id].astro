---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ActionList from '../../components/ActionList.astro';
import Face from '../../components/Face.astro';
import PortraitCredit from '../../components/PortraitCredit.astro';
import { getEntries, placeUrl, type Official } from '../../lib/data.ts';
import { PARTY_NAMES, ROLE_LABEL, nameWithParty } from '../../lib/format.ts';

export async function getStaticPaths() {
  return (await getCollection('officials')).map((official) => ({ params: { id: official.id }, props: { official } }));
}

const { official } = Astro.props as { official: Official };
const o = official.data;
const place = (await getEntry(o.jurisdiction))!;
const entries = (await getEntries()).filter((e) => e.data.credit.some((c) => c.official.id === official.id));
// "Proposed it and signed it": every role this official played, as one phrase.
const and = new Intl.ListFormat('en', { type: 'conjunction' });
const captions = new Map(
  entries.map((e) => {
    const roles = e.data.credit.filter((c) => c.official.id === official.id).map((c) => ROLE_LABEL[c.role]);
    return [e.id, and.format(roles.map((r, i) => (i ? r[0].toLowerCase() + r.slice(1) : r)))];
  }),
);
const tenure = o.current ? 'Serving now' : 'Former';
---

<Base
  title={nameWithParty(o)}
  description={`What ${o.name} did for people as ${o.office}: ${entries.length} action${entries.length === 1 ? '' : 's'} on record.`}
>
  <header class="cover" id="cover">
    <div class="cover-in">
      <div class="who">
        <h1>{nameWithParty(o)}</h1>
        <p class="office">{o.office}</p>
        <p class="meta">
          {o.kind === 'person' && o.party && <span>{PARTY_NAMES[o.party]}</span>}
          {o.kind === 'person' && <span>{tenure}</span>}
          <a href={placeUrl(place.id)}>{place.data.name}</a>
          {o.url && <a href={o.url}>Official website</a>}
        </p>
        {o.portrait && <PortraitCredit people={[official]} class="person-credit" />}
        {o.kind === 'person' && !o.portrait && <p class="no-photo">No photo on file, so initials stand in.</p>}
      </div>
      <Face official={official} variant="cutout" class="person-face" eager sizes="(min-width: 60rem) 26rem, 14rem" />
    </div>
  </header>
  <div class="wrap">
    <section aria-labelledby="did-h" class="did">
      <h2 id="did-h">
        {entries.length > 0 ? `What ${o.kind === 'body' ? 'it' : o.name.split(' ').at(-1)} did for people` : 'Nothing on record yet'}
      </h2>
      {
        entries.length > 0 ? (
          <ActionList entries={entries} captions={captions} />
        ) : (
          <p class="empty">
            We haven't recorded any actions credited to {o.name} yet. If you know of one, <a href="mailto:corrections@whatdidgovtdofor.you">tell us</a>.
          </p>
        )
      }
    </section>
  </div>
</Base>

<style>
  .cover {
    background: var(--orange);
    overflow: hidden;
  }
  .cover-in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 9.5rem;
    align-items: end;
    gap: 0 1rem;
    width: min(100% - 2 * var(--gutter), var(--page));
    margin-inline: auto;
  }
  .who {
    padding: 1.25rem 0 1rem;
  }
  h1 {
    font-size: clamp(var(--t-2xl), 8vw, var(--t-5xl));
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .office {
    margin-top: 0.6rem;
    font-weight: 600;
    font-size: var(--t-md);
    line-height: 1.3;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin-top: 0.75rem;
    font-weight: 600;
    font-size: 1rem;
  }
  .meta > * {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .no-photo {
    font-size: 1rem;
  }
  .cover :global(.person-face) {
    align-self: end;
    margin-right: -1rem;
  }
  .cover :global(.person-face.t-body) {
    display: none;
  }
  .cover :global(.person-face.t-initials span) {
    font-size: 70cqw;
  }
  @media (min-width: 60rem) {
    .cover-in {
      grid-template-columns: minmax(0, 1fr) 26rem;
    }
    .who {
      padding: 3rem 0 2.5rem;
    }
  }
  .did {
    margin-top: 3rem;
  }
  .did h2 {
    margin-bottom: 0.5rem;
    font-size: clamp(var(--t-xl), 4vw, var(--t-2xl));
  }
  .empty {
    font-size: var(--t-body);
    max-width: var(--measure);
  }
</style>
