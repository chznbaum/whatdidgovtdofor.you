---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ActionList from '../../components/ActionList.astro';
import Face from '../../components/Face.astro';
import PortraitCredit from '../../components/PortraitCredit.astro';
import { getEntries, getPlacesMap, officialModified, placeUrl, type Official } from '../../lib/data.ts';
import { officialFeedUrl } from '../../lib/feed.ts';
import { officialNodes } from '../../lib/jsonld.ts';
import { ROLE_LABEL, nameWithParty } from '../../lib/format.ts';

export async function getStaticPaths() {
  return (await getCollection('officials')).map((official) => ({ params: { id: official.id }, props: { official } }));
}

const { official } = Astro.props as { official: Official };
const o = official.data;
const place = (await getEntry(o.jurisdiction))!;
const entries = (await getEntries()).filter((e) => e.data.credit.some((c) => c.official.id === official.id));
// "Proposed it and signed it": every role this official played, as one phrase.
const and = new Intl.ListFormat('en', { type: 'conjunction' });
const captions = new Map(
  entries.map((e) => {
    const roles = e.data.credit.filter((c) => c.official.id === official.id).map((c) => ROLE_LABEL[c.role]);
    return [e.id, and.format(roles.map((r, i) => (i ? r[0].toLowerCase() + r.slice(1) : r)))];
  }),
);
const tenure = o.current ? 'Serving now' : 'Former';

// The place is linked where the title already names it ("U.S. Senator from [Virginia]"), by its name, its name
// without "County", or its short name ("NYC"). Otherwise it gets its own link beside the party and tenure.
const escapeRe = (x: string) => x.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const aliases = [place.data.name, place.data.name.replace(/ County$/, ''), place.data.short, ...(place.id === 'us' ? ['U.S.'] : [])];
const named = aliases
  .filter(Boolean)
  .map((a) => new RegExp(`\\b${escapeRe(a)}(?![A-Za-z])`).exec(o.office))
  .filter((m): m is RegExpExecArray => Boolean(m))
  .sort((a, b) => b[0].length - a[0].length)[0];
const office = named
  ? { before: o.office.slice(0, named.index), place: named[0], after: o.office.slice(named.index + named[0].length) }
  : undefined;

// The name links to the official's own website, marked like every link that leaves the site (global.css).


---

<Base
  title={nameWithParty(o)}
  feed={entries.length ? { href: officialFeedUrl(official.id), title: `${nameWithParty(o)} | whatdidgovtdofor.you` } : undefined}
  jsonld={officialNodes(official, place, await getPlacesMap(), officialModified(official, await getEntries()))}
  metaTitle={o.kind === 'person' && !o.name.includes(o.office) ? `${nameWithParty(o)}, ${o.office}` : nameWithParty(o)}
  description={`What ${o.name} did for people as ${o.office}: ${entries.length} action${entries.length === 1 ? '' : 's'} on record.`}
>
  <header class="cover" id="cover">
    <div class="who">
      <div class="top">
        <h1>
          {
            o.url ? (
              <a class="site" href={o.url} target="_blank" rel="noopener" aria-label={`${nameWithParty(o)}, official website, opens in a new tab`}>{nameWithParty(o)}</a>
            ) : (
              nameWithParty(o)
            )
          }
        </h1>
        <p class="office">
          {office ? (
            <>
              {office.before}
              <a href={placeUrl(place.id)}>{office.place}</a>
              {office.after}
            </>
          ) : (
            o.office
          )}
        </p>
      </div>
      {
        o.kind === 'person' && (
          <div class="portrait">
            <Face official={official} variant="cutout" eager sizes="(min-width: 60rem) 26rem, 11rem" />
          </div>
        )
      }
      <div class="rest">
        {
          (o.kind === 'person' || !office) && (
            // The party shows once, as the initial after the name.
            <p class="meta">
              {o.kind === 'person' && <span>{tenure}</span>}
              {!office && <a href={placeUrl(place.id)}>{place.data.name}</a>}
            </p>
          )
        }
        {o.portrait && <PortraitCredit people={[official]} full class="person-credit" />}
        {o.kind === 'person' && !o.portrait && <p class="no-photo">No photo on file, so initials stand in.</p>}
      </div>
    </div>
  </header>
  <div class="wrap">
    <section aria-labelledby="did-h" class="did">
      <h2 id="did-h">
        {entries.length > 0 ? `What ${o.kind === 'body' ? 'it' : o.name.split(' ').at(-1)} did for people` : 'Nothing on record yet'}
      </h2>
      {
        entries.length > 0 ? (
          <>
            <ActionList entries={entries} captions={captions} />
            <p class="feed">
              <a href={officialFeedUrl(official.id)}>RSS feed</a>
            </p>
          </>
        ) : (
          <p class="empty">
            We haven't recorded any actions credited to {o.name} yet. If you know of one, <a href="mailto:corrections@whatdidgovtdofor.you">tell us</a>.
          </p>
        )
      }
    </section>
  </div>
</Base>

<style>
  /* The header's layout follows its own width (a container), not the screen's. */
  .cover {
    container: cover / inline-size;
    background: var(--orange);
    overflow: hidden;
  }
  /* Phone: name and title across the full width; below them, the short lines (tenure, photo credit) beside the
     drawing, which sits at the bottom of its cell so it always rises from the header's bottom edge. */
  .who {
    display: grid;
    grid-template-columns: minmax(0, 1fr) min(11rem, 44cqw);
    grid-template-areas:
      'top top'
      'rest portrait';
    column-gap: 0.75rem;
    width: min(100% - 2 * var(--gutter), var(--page));
    margin-inline: auto;
    padding-top: 1.25rem;
  }
  .top {
    grid-area: top;
  }
  .rest {
    grid-area: rest;
    padding-bottom: 1rem;
  }
  .portrait {
    grid-area: portrait;
    align-self: end;
    margin: 0.75rem -1rem 0 0;
  }
  h1 {
    font-size: clamp(var(--t-2xl), 8vw, var(--t-5xl));
    line-height: 1;
    letter-spacing: -0.02em;
  }
  h1 .site {
    text-decoration: none;
  }
  h1 .site:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
  }
  /* At headline size the mark is smaller and raised, so it doesn't compete with the name. */
  h1 a.site::after {
    padding-left: 0.56em;
    background-size: 0.42em 0.42em;
    background-position: right 0.12em;
  }
  .feed {
    margin-top: 3rem;
    font-weight: 600;
    font-size: 1rem;
  }
  .feed a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .office {
    margin-top: 0.6rem;
    font-weight: 600;
    font-size: var(--t-md);
    line-height: 1.3;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.25rem;
    margin-top: 0.75rem;
    font-weight: 600;
    font-size: 1rem;
  }
  /* Only links need a full-size touch target; plain text sits at its own height. */
  .meta a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .no-photo {
    font-size: 1rem;
  }
  /* The photo credit and the initials note, set off from the party and tenure above them. */
  .who :global(.person-credit),
  .no-photo {
    margin-top: 0.85rem;
  }
  .portrait :global(.t-initials span) {
    font-size: 70cqw;
  }

  /* Desktop: text on the left, bottom-aligned; the drawing in its own column on the right. The first row takes the
     spare height, so the text sits low. */
  @container cover (width >= 60rem) {
    .who {
      grid-template-columns: minmax(0, 1fr) 26rem;
      grid-template-rows: 1fr auto auto;
      grid-template-areas:
        '. portrait'
        'top portrait'
        'rest portrait';
      column-gap: 1rem;
      padding-top: 3rem;
    }
    .rest {
      padding-bottom: 2.5rem;
    }
    .portrait {
      margin: 0 -1rem 0 0;
    }
  }
  .did {
    margin-top: 3rem;
  }
  .did h2 {
    margin-bottom: 0.5rem;
    font-size: clamp(var(--t-xl), 4vw, var(--t-2xl));
  }
  .empty {
    font-size: var(--t-body);
    max-width: var(--measure);
  }
</style>
