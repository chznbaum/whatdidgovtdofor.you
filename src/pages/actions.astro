---
import Base from '../layouts/Base.astro';
import ActionList from '../components/ActionList.astro';
import StatusMark from '../components/StatusMark.astro';
import { getEntries } from '../lib/data.ts';
import { TOPIC_LABELS } from '../lib/format.ts';

const entries = await getEntries();
const topics = Object.entries(TOPIC_LABELS).filter(([t]) => entries.some((e) => e.data.topics.includes(t as never)));

const filters = {
  group: [
    ['', 'Any status', null],
    ['working', 'Working now', 'full'],
    ['coming', 'Coming', 'half'],
    ['threat', 'Under threat', 'threat'],
    ['ended', 'Ended', 'ring'],
  ] as const,
  level: [
    ['', 'All governments'],
    ['federal', 'Federal'],
    ['state', 'State'],
    ['local', 'Local'],
  ],
};
---

<Base title="All actions" description="Every government action on record, with its status and who made it happen.">
  <div class="wrap">
    <h1>All actions</h1>
    <form class="filters" data-filters aria-label="Filter actions">
      <fieldset>
        <legend>Status</legend>
        {
          filters.group.map(([value, label, mark], i) => (
            <label>
              <input type="radio" name="status" value={value} checked={i === 0} />
              <span>
                {mark && <StatusMark mark={mark} size={16} />}
                {label}
              </span>
            </label>
          ))
        }
      </fieldset>
      <fieldset>
        <legend>Government</legend>
        {
          filters.level.map(([value, label], i) => (
            <label>
              <input type="radio" name="level" value={value} checked={i === 0} />
              <span>{label}</span>
            </label>
          ))
        }
      </fieldset>
      <label class="topic">
        <span>Topic</span>
        <select name="topic">
          <option value="">Any topic</option>
          {topics.map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </label>
    </form>
    <p class="count" role="status" aria-live="polite" data-count>{entries.length} actions</p>
    <ActionList entries={entries} heading="h2" />
    <p class="empty" data-empty hidden>Nothing matches those filters. Try a different status or topic.</p>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filters]')!;
  const items = [...document.querySelectorAll<HTMLElement>('li[data-entry]')];
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;

  function apply() {
    const f = new FormData(form);
    const status = f.get('status') as string;
    const level = f.get('level') as string;
    const topic = f.get('topic') as string;
    let n = 0;
    for (const li of items) {
      const show =
        (!status || li.dataset.group === status) &&
        (!level || li.dataset.level === level) &&
        (!topic || li.dataset.topics!.split(' ').includes(topic));
      li.hidden = !show;
      if (show) n++;
    }
    count.textContent = `${n} action${n === 1 ? '' : 's'}`;
    empty.hidden = n > 0;
    const params = new URLSearchParams([...f].filter(([, v]) => v) as [string, string][]);
    history.replaceState(null, '', params.size ? `?${params}` : location.pathname);
  }

  // Restore filters from the URL so filtered views can be shared.
  const params = new URLSearchParams(location.search);
  for (const [k, v] of params) {
    const field = form.elements.namedItem(k);
    if (field instanceof RadioNodeList || field instanceof HTMLSelectElement) field.value = v;
  }
  form.addEventListener('change', apply);
  if (params.size) apply();
</script>

<style>
  h1 {
    margin-top: 2rem;
    font-size: clamp(var(--t-3xl), 7vw, var(--t-5xl));
    letter-spacing: -0.02em;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
  }
  fieldset {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    border: 0;
  }
  legend,
  .topic > span {
    display: block;
    width: 100%;
    margin-bottom: 0.4rem;
    font-weight: 700;
    font-size: 1rem;
  }
  fieldset label {
    position: relative;
  }
  fieldset input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  fieldset span {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0 0.85rem;
    border: 2px solid var(--ink);
    background: var(--paper);
    font-weight: 700;
    font-size: 1rem;
  }
  fieldset input:checked + span {
    background: var(--ink);
    color: var(--paper);
  }
  fieldset input:focus-visible + span {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }
  select {
    min-height: 44px;
    padding: 0 0.6rem;
    border: 2px solid var(--ink);
    border-radius: 0;
    background: var(--paper);
    font: 600 1rem var(--text);
  }
  .count {
    margin-block: 1.5rem 0.5rem;
    font-weight: 700;
  }
  .empty {
    font-size: var(--t-body);
  }
</style>
