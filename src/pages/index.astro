---
import Base from '../layouts/Base.astro';
import AddressForm from '../components/AddressForm.astro';
import SignGrid from '../components/SignGrid.astro';
import { entriesWithin, getEntries, getPlacesMap, placeUrl, type Entry } from '../lib/data.ts';
import { TONE } from '../lib/status.ts';

const entries = await getEntries();
const places = await getPlacesMap();

// The distance sign: each place with the number of actions on record there.
const destinations = ['us', 'ny', 'nyc', 'va', 'hampton-roads'].map((id) => {
  const place = places.get(id)!;
  const count = id === 'us' ? entries.filter((e) => e.data.level === 'federal').length : entriesWithin(id, entries, places).length;
  return { id, name: place.data.name, count };
});

const bipartisan = (e: Entry) =>
  e.data.votes.some((v) => (v.by_party?.D?.yes ?? 0) > 0 && (v.by_party?.R?.yes ?? 0) > 0);

// Each section skips signs already shown above it. Every under-threat sign gets its own section.
const shown = new Set<Entry>();
const take = (list: Entry[], n: number) => {
  const out = list.filter((e) => !shown.has(e)).slice(0, n);
  out.forEach((e) => shown.add(e));
  return out;
};
const threatenedAll = entries.filter((e) => e.data.status.state === 'under-threat');
const live = entries.filter((e) => TONE[e.data.status.state] !== 'stop' && !threatenedAll.includes(e));
const featured = take(live.filter((e) => e.data.featured), 8);
const recent = take(live, 6);
const threatened = take(threatenedAll, 12);
const bothParties = take(live.filter(bipartisan), 6);
const ended = take(entries.filter((e) => TONE[e.data.status.state] === 'stop'), 6);
---

<Base>
  <section class="road" aria-labelledby="hero-h">
    <div class="wrap gantry">
      <div class="mount">
        <div class="panel big">
          <div class="face">
            <h1 id="hero-h">What did government do for you?</h1>
            <AddressForm />
          </div>
        </div>
      </div>
      <div class="mount">
        <nav class="panel distance" aria-labelledby="dest-h">
          <div class="face">
            <h2 id="dest-h">Actions on record</h2>
            <ul role="list">
              {
                destinations.map((d) => (
                  <li>
                    <a href={placeUrl(d.id)}>
                      <span class="dest">{d.name}</span>
                      <span class="miles num">{d.count}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </nav>
      </div>
    </div>
  </section>

  <div class="wrap sections">
    {
      featured.length > 0 && (
        <section aria-labelledby="start-h">
          <header class="sec-head">
            <h2 id="start-h">Start here</h2>
            <p>Things government did that you can feel in your wallet, your commute, or your doctor's office.</p>
          </header>
          <SignGrid entries={featured} />
        </section>
      )
    }

    {
      recent.length > 0 && (
        <section aria-labelledby="recent-h">
          <header class="sec-head">
            <h2 id="recent-h">Most recent</h2>
            <p>The latest actions on record, newest first.</p>
          </header>
          <SignGrid entries={recent} />
        </section>
      )
    }

    {
      threatened.length > 0 && (
        <section aria-labelledby="threat-h">
          <header class="sec-head">
            <h2 id="threat-h">Could be taken away</h2>
            <p>These are in effect today, but a specific effort is under way to end or gut them. Each sign names it.</p>
          </header>
          <SignGrid entries={threatened} />
        </section>
      )
    }

    {
      bothParties.length > 0 && (
        <section aria-labelledby="both-h">
          <header class="sec-head">
            <h2 id="both-h">Passed with votes from both parties</h2>
            <p>Delivering for people isn't one party's job. When Republicans and Democrats both did it, we say so.</p>
          </header>
          <SignGrid entries={bothParties} />
        </section>
      )
    }

    {
      ended.length > 0 && (
        <section aria-labelledby="ended-h">
          <header class="sec-head">
            <h2 id="ended-h">Already taken away</h2>
            <p>Some things government did for you have been repealed, allowed to expire, or blocked.</p>
          </header>
          <SignGrid entries={ended} />
        </section>
      )
    }

    <p class="all"><a href="/actions/">See all {entries.length} action{entries.length === 1 ? '' : 's'}</a></p>
  </div>
</Base>

<style>
  /* Hero: two signs on posts, standing on a ground line. */
  .road {
    padding-top: clamp(1rem, 4vw, 3rem);
    border-bottom: 3px solid var(--steel);
  }
  .gantry {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
    gap: 0 2rem;
  }
  @media (min-width: 60rem) {
    .gantry {
      grid-template-columns: minmax(0, 1.75fr) minmax(18rem, 1fr);
    }
  }

  .mount {
    --post: 12px;
    padding-bottom: clamp(2.5rem, 7vw, 4.5rem);
    background:
      linear-gradient(var(--steel), var(--steel)) 18% 100% / var(--post) 100% no-repeat,
      linear-gradient(var(--steel), var(--steel)) 82% 100% / var(--post) 100% no-repeat;
  }
  @media (max-width: 59.99rem) {
    .mount:first-child {
      padding-bottom: 1.25rem;
      background: none;
    }
  }

  .panel {
    position: relative;
    padding: 9px;
    background: var(--guide);
    color: var(--paper);
    border-radius: 24px;
  }
  .face {
    height: 100%;
    border: 5px solid var(--paper);
    border-radius: 15px;
    padding: clamp(1.5rem, 4vw, 2.75rem);
  }

  h1 {
    max-width: 12ch;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700;
    font-size: clamp(2.75rem, 8vw, var(--t-4xl));
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  .distance h2 {
    margin-bottom: 1rem;
    font-size: var(--t-md);
    font-weight: 700;
  }
  .distance ul {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .distance a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding-block: 0.2rem;
    text-decoration: none;
    font-weight: 700;
    font-size: var(--t-lg);
    line-height: 1.1;
  }
  .distance a:hover .dest {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }
  .miles {
    font-weight: 800;
  }

  .sections {
    display: grid;
    gap: clamp(3.5rem, 8vw, 5.5rem);
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  .sec-head {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .sec-head h2 {
    font-size: clamp(var(--t-lg), 4vw, var(--t-xl));
  }
  .sec-head p {
    font-family: var(--serif);
    font-size: var(--t-body);
    line-height: 1.5;
    max-width: 56ch;
  }
  .all a {
    font-weight: 800;
    font-size: var(--t-md);
  }
</style>
