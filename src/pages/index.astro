---
// The cover: the site's question, answered by a face. Then the address lookup, and more people with what they did.
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import AddressForm from '../components/AddressForm.astro';
import ActionList from '../components/ActionList.astro';
import Face from '../components/Face.astro';
import PortraitCredit from '../components/PortraitCredit.astro';
import Status from '../components/Status.astro';
import { entriesWithin, entryUrl, getEntries, getLead, getPlacesMap, placeUrl, type Entry } from '../lib/data.ts';
import { ROLE_BYLINE, nameWithParty } from '../lib/format.ts';
import { GROUP } from '../lib/status.ts';

const entries = await getEntries();
const places = await getPlacesMap();

// The cover story (see getLead).
const lead = await getLead(entries);
const featured = entries.filter((e) => e.data.featured);
const ld = lead.data;
const leadCredit = ld.credit[0];
const leadPerson = (await getEntry(leadCredit.official))!;
const leadFig = ld.impact.find((i) => !ld.title.toLowerCase().includes(i.figure.toLowerCase()));

// More people: the featured actions. Then whatever else is under threat, and what has already ended.
const shown = new Set<Entry>([lead]);
const take = (list: Entry[]) => list.filter((e) => !shown.has(e) && shown.add(e));
const more = take(featured);
const threatened = take(entries.filter((e) => GROUP[e.data.status.state] === 'threat'));
const ended = take(entries.filter((e) => GROUP[e.data.status.state] === 'ended'));

const destinations = ['us', 'va', 'hampton-roads', 'ny', 'nyc'].map((id) => {
  const place = places.get(id)!;
  const count = id === 'us' ? entries.filter((e) => e.data.level === 'federal').length : entriesWithin(id, entries, places).length;
  return { id, name: place.data.name, count };
});
---

<Base>
  <div class="top" id="lead">
    <section class="cover" aria-labelledby="q">
      <h1 id="q" class="q"><span>What did</span> <span>government</span> <span>do for</span> <span>you?</span></h1>
      <Face official={leadPerson} variant="cutout" class="lead-face" eager sizes="(min-width: 60rem) 36rem, 22rem" />
      <PortraitCredit people={[leadPerson]} class="lead-credit" />
    </section>

    <div class="side on-ink">
      <section class="deed" aria-label="What they did">
        <h2 class="deed-what"><a href={entryUrl(lead)}>{ld.title}</a></h2>
        <p class="deed-who">
          {ROLE_BYLINE[leadCredit.role]} {nameWithParty(leadPerson.data)}.{leadCredit.note && ` ${leadCredit.note}.`}
        </p>
        <Status entry={lead} class="deed-status" />
        {
          leadFig && (
            <p class="deed-fig">
              <b>{leadFig.figure}</b> {leadFig.label}
            </p>
          )
        }
      </section>
      <AddressForm />
    </div>
  </div>

  <div class="wrap lists">
    <section aria-labelledby="more-h">
      <h2 id="more-h" class="sec-h">More people who did something</h2>
      <ActionList entries={more} threatDetail />
    </section>

    {
      threatened.length > 0 && (
        <section aria-labelledby="threat-h">
          <h2 id="threat-h" class="sec-h">Could be taken away</h2>
          <ActionList entries={threatened} threatDetail />
        </section>
      )
    }

    {
      ended.length > 0 && (
        <section aria-labelledby="ended-h">
          <h2 id="ended-h" class="sec-h">Already ended</h2>
          <ActionList entries={ended} />
        </section>
      )
    }

    <p class="all"><a href="/actions/">See all {entries.length}, with who did each one</a></p>
  </div>

  <nav class="places on-ink" aria-labelledby="places-h">
    <div class="wrap">
      <h2 id="places-h">Places</h2>
      <ul role="list">
        {
          destinations.map((d) => (
            <li>
              <a href={placeUrl(d.id)}>
                {d.name} <span class="num">{d.count}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</Base>

<style>
  /* ---------- the cover: the question, and a face answering it ---------- */
  .top {
    background: var(--orange);
  }
  .cover {
    position: relative;
    height: 27.5rem;
    overflow: hidden;
  }
  .q {
    position: relative;
    z-index: 1;
    padding: 0.4rem var(--gutter) 0;
    font-size: 3.625rem;
    line-height: 0.98;
    letter-spacing: -0.025em;
  }
  .q span {
    display: block;
  }
  .cover :global(.lead-face) {
    position: absolute;
    z-index: 2;
    width: 23.5rem;
    right: -3.75rem;
    bottom: -3.25rem;
  }
  .cover :global(.lead-credit) {
    position: absolute;
    z-index: 3;
    left: var(--gutter);
    bottom: 0.25rem;
    max-width: 10rem;
  }

  /* ---------- the deed, on ink ---------- */
  .side {
    background: var(--ink);
    color: var(--paper);
  }
  .deed {
    padding: 1rem var(--gutter) 1.1rem;
  }
  .deed-what {
    font-size: 1.6875rem;
    line-height: 1.12;
  }
  .deed-what a {
    text-decoration: none;
  }
  .deed-what a:hover {
    text-decoration: underline;
  }
  .deed-who {
    margin: 0.6rem 0 0.75rem;
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.4;
  }
  .deed-fig {
    margin-top: 0.5rem;
    font-size: 1rem;
  }
  .side :global(.lookup) {
    padding: 1rem var(--gutter) 1.4rem;
    background: var(--paper);
    color: var(--ink);
  }

  /* ---------- lists ---------- */
  .lists {
    display: grid;
    gap: 4rem;
    margin-top: 2.5rem;
  }
  .all a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-weight: 700;
    font-size: 1.0625rem;
  }
  .places {
    margin-top: 4rem;
    margin-bottom: -5rem; /* sits flush on whatever ends the page */
    padding: 2rem 0 2.5rem;
    background: var(--ink);
    color: var(--paper);
  }
  .places h2 {
    font-size: var(--t-xl);
    margin-bottom: 0.5rem;
  }
  .places ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .places a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    font-weight: 600;
    font-size: 1.0625rem;
  }

  /* ---------- desktop ---------- */
  @media (min-width: 60rem) {
    .top {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 27rem;
    }
    .cover {
      height: min(calc(100vh - 4.5rem), 38rem);
      min-height: 34rem;
    }
    .q {
      padding: 0.25rem 0 0 max(var(--gutter), (100vw - var(--page)) / 2);
      font-size: clamp(5.5rem, 7.2vw, 6.75rem);
      line-height: 0.94;
    }
    .cover :global(.lead-face) {
      width: min(36rem, 62%);
      right: -3.5rem;
      bottom: -4.5rem;
    }
    .cover :global(.lead-credit) {
      left: max(var(--gutter), (100vw - var(--page)) / 2);
      bottom: 0.5rem;
      max-width: 20rem; /* wraps in the clear space left of the drawing */
    }
    .side {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 1.75rem;
    }
    .deed {
      padding: 0 2.5rem;
    }
    .deed-what {
      font-size: 2.375rem;
      line-height: 1.06;
    }
    .side :global(.lookup) {
      padding: 0 2.5rem;
      background: none;
      color: var(--paper);
    }
    .lists {
      margin-top: 3rem;
    }
  }
</style>
