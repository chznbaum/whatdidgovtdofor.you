---
import Base from '../layouts/Base.astro';
import AddressForm from '../components/AddressForm.astro';
import ActionList from '../components/ActionList.astro';
import { getEntries } from '../lib/data.ts';

// Every sign is rendered here, hidden; the script below reveals the ones that apply to the address.
const entries = await getEntries();
const levels = [
  { level: 'local', title: 'From your local government' },
  { level: 'state', title: 'From your state' },
  { level: 'federal', title: 'From Washington' },
] as const;
---

<Base title="What government did for you" description="Enter your address to see your officials and what they did for you.">
  <div class="wrap">
    <div class="ask">
      <div class="face">
        <h1>What did government do for you?</h1>
        <AddressForm id="you-address" />
      </div>
    </div>

    <p class="status" role="status" aria-live="polite" data-status></p>

    <section class="officials" aria-labelledby="off-h" data-officials hidden>
      <h2 id="off-h">Your officials</h2>
      <p class="districts" data-districts></p>
      <div class="tiers" data-tiers></div>
      <p class="coverage" data-coverage hidden>
        We cover national actions everywhere, and state and local actions in New York and Virginia so far.
        <a href="mailto:places@whatdidgovtdofor.you" data-ask>Ask us to add your area</a>.
      </p>
      <p class="coverage" data-local-coverage hidden>
        We don't track <span data-local-name></span>'s local government yet.
        <a href="mailto:places@whatdidgovtdofor.you" data-ask>Ask us to add it</a>.
      </p>
      <p class="turn">
        <a href="/your-turn/" data-turn>Your turn: run for office, join a board, or work the polls<span data-turn-where></span></a>
      </p>
    </section>

    <div class="results" data-results hidden>
      {
        levels.map(({ level, title }) => (
          <section aria-labelledby={`lvl-${level}`} data-level-section={level}>
            <h2 id={`lvl-${level}`}>{title}</h2>
            <ActionList entries={entries.filter((e) => e.data.level === level)} />
          </section>
        ))
      }
    </div>
  </div>
</Base>

<script>
  type Person = { name: string; party: string; office: string; id: string | null; url: string | null; n: number };
  type Seat = Person & { place: string; title: string };
  type Member = Person & { district: string | null; role: string; lead: boolean };
  type Lookup = { census: true; label: string } | { census?: undefined; url: string; field: string; label: string };
  type Council = { body: string; districts: Lookup[]; members: Member[] };
  type PlaceInfo = {
    id: string;
    name: string;
    kind: string;
    geoids: { state?: string; county?: string; place?: string };
    members: string[];
  };
  type Index = {
    geocoder: { benchmark: string; vintage: string };
    places: PlaceInfo[];
    congress: Record<string, { senate: Person[]; house: Record<string, Person> }>;
    legislatures: Record<string, { place: string; upper: Record<string, Person>; lower: Record<string, Person> }>;
    councils: Record<string, Council>;
    seats: Seat[];
  };
  type Geo = Record<string, Record<string, string>[]>;

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const statusEl = $('[data-status]');
  const officialsEl = $('[data-officials]');
  const resultsEl = $('[data-results]');
  const input = $<HTMLInputElement>('#you-address');
  const indexPromise: Promise<Index> = fetch('/lookup-index.json').then((r) => r.json());

  // The Census geocoder doesn't send CORS headers, but it does support JSONP.
  function geocode(address: string, cfg: Index['geocoder']): Promise<any> {
    return new Promise((resolve, reject) => {
      const cb = `__census${Date.now()}`;
      const script = document.createElement('script');
      const timer = setTimeout(() => done(new Error('timeout')), 20000);
      function done(err?: Error, data?: unknown) {
        clearTimeout(timer);
        delete (window as any)[cb];
        script.remove();
        err ? reject(err) : resolve(data);
      }
      (window as any)[cb] = (data: unknown) => done(undefined, data);
      script.onerror = () => done(new Error('network'));
      const params = new URLSearchParams({
        address,
        benchmark: cfg.benchmark,
        vintage: cfg.vintage,
        layers: 'all',
        format: 'jsonp',
        callback: cb,
      });
      script.src = `https://geocoding.geo.census.gov/geocoder/geographies/onelineaddress?${params}`;
      document.head.append(script);
    });
  }

  // Council district for a point, from an ArcGIS feature service. Failure (or a server slower than 8 seconds) just
  // means no district member shown.
  async function councilDistrict(cfg: { url: string; field: string }, x: number, y: number): Promise<string | undefined> {
    const params = new URLSearchParams({
      geometry: `${x},${y}`,
      geometryType: 'esriGeometryPoint',
      inSR: '4326',
      spatialRel: 'esriSpatialRelIntersects',
      outFields: cfg.field,
      returnGeometry: 'false',
      f: 'json',
    });
    try {
      const res = await fetch(`${cfg.url}/query?${params}`, { signal: AbortSignal.timeout(8000) });
      const value = (await res.json()).features?.[0]?.attributes?.[cfg.field];
      return value == null ? undefined : String(value);
    } catch {
      return undefined;
    }
  }

  // "Ward 2", "Chuckatuck Borough", "Brookland District".
  const districtName = (d: string, label: string) => (/^\d+$/.test(d) ? `${label} ${d}` : `${d} ${label}`);
  // Layers spell districts their own way ("CLOVERHILL", "HOLY NECK"), so compare letters and digits only.
  const sameDistrict = (a: string, b: string) => a.toLowerCase().replace(/[^a-z0-9]/g, '') === b.toLowerCase().replace(/[^a-z0-9]/g, '');

  const layer = (geo: Geo, test: RegExp) => Object.entries(geo).find(([k, v]) => test.test(k) && v.length)?.[1][0];
  const ordinal = (n: number) => {
    const s = ['th', 'st', 'nd', 'rd'];
    const v = n % 100;
    return n + (s[(v - 20) % 10] || s[v] || s[0]);
  };

  function el(tag: string, attrs: Record<string, string> = {}, ...children: (Node | string)[]) {
    const node = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v);
    node.append(...children);
    return node;
  }

  function officialItem(title: string, p: Person) {
    const label = p.party && p.party !== 'NP' ? `${p.name} (${p.party})` : p.name;
    const href = p.id ? `/officials/${p.id}/` : p.url;
    const name = href ? el('a', { href, class: 'name' }, label) : el('span', { class: 'name' }, label);
    const record = p.n
      ? el('a', { href: `/officials/${p.id}/`, class: 'record' }, `${p.n} action${p.n === 1 ? '' : 's'} on record`)
      : el('span', { class: 'record none' }, 'No actions on record yet');
    return el('li', {}, el('span', { class: 'title' }, title), name, record);
  }

  function tier(title: string, items: HTMLElement[]) {
    if (!items.length) return null;
    return el('section', { class: 'tier' }, el('h3', {}, title), el('ul', { role: 'list' }, ...items));
  }

  async function lookup(address: string) {
    input.value = address;
    statusEl.textContent = 'Looking up your districts…';
    officialsEl.hidden = true;
    resultsEl.hidden = true;

    let index: Index;
    let result: any;
    try {
      index = await indexPromise;
      result = await geocode(address, index.geocoder);
    } catch {
      statusEl.textContent =
        "We couldn't reach the Census Bureau's address lookup. Check your connection and try again in a moment.";
      return;
    }

    const match = result?.result?.addressMatches?.[0];
    if (!match) {
      statusEl.textContent =
        "We couldn't find that address. Include the street number, street, city, and state, like \"810 Union St, Norfolk, VA\".";
      return;
    }

    const geo: Geo = match.geographies;
    const state = layer(geo, /^States$/);
    const fips = state?.STATE ?? state?.GEOID;
    const abbr = state?.STUSAB;
    const cd = layer(geo, /Congressional Districts/);
    const upper = layer(geo, /State Legislative Districts - Upper/);
    const lower = layer(geo, /State Legislative Districts - Lower/);
    const county = layer(geo, /^Counties$/);
    const incPlace = layer(geo, /^Incorporated Places$/);

    // Which of our places contain this address: the country, the state, a city or county, and any regions.
    const mine = new Set(['us']);
    for (const p of index.places) {
      const g = p.geoids;
      if (p.kind === 'state' && g.state === fips) mine.add(p.id);
      if ((p.kind === 'city' || p.kind === 'county' || p.kind === 'town') && ((g.place && g.place === incPlace?.GEOID) || (g.county && g.county === county?.GEOID)))
        mine.add(p.id);
    }
    for (const p of index.places) if (p.kind === 'region' && p.members.some((m) => mine.has(m))) mine.add(p.id);

    // Officials.
    const seatsFor = (placeId: string) => index.seats.filter((s) => s.place === placeId);
    const congress = abbr ? index.congress[abbr] : undefined;
    const district = cd ? String(parseInt(cd.GEOID.slice(2), 10)) : undefined;
    const legislature = fips ? index.legislatures[fips] : undefined;

    const national = [
      ...seatsFor('us').map((s) => officialItem(s.title, s)),
      ...(congress?.senate ?? []).map((p) => officialItem('U.S. Senator', p)),
      ...(congress && district && congress.house[district] ? [officialItem('U.S. Representative', congress.house[district])] : []),
    ];
    const stateItems = legislature
      ? [
          ...seatsFor(legislature.place).map((s) => officialItem(s.title, s)),
          ...(upper && legislature.upper[String(parseInt(upper.BASENAME, 10))]
            ? [officialItem('State Senator', legislature.upper[String(parseInt(upper.BASENAME, 10))])]
            : []),
          ...(lower && legislature.lower[String(parseInt(lower.BASENAME, 10))]
            ? [officialItem(fips === '51' ? 'Delegate' : 'Assembly Member', legislature.lower[String(parseInt(lower.BASENAME, 10))])]
            : []),
        ]
      : [];
    const localPlaces = index.places.filter((p) => mine.has(p.id) && (p.kind === 'city' || p.kind === 'county' || p.kind === 'town'));
    // Each local place's own seats (a mayor), then its council: a council's own mayor, the members for each of the
    // address's districts, then the other members elected at large. A district lookup that fails just leaves those
    // members out.
    const subdivision = layer(geo, /^County Subdivisions$/);
    const localItems: HTMLElement[] = [];
    const localWhere: string[] = [];
    for (const p of localPlaces) {
      localItems.push(...seatsFor(p.id).map((s) => officialItem(s.title, s)));
      localWhere.push(p.name);
      const council = index.councils[p.id];
      if (!council) continue;
      const atLarge = council.members.filter((m) => m.district === null);
      localItems.push(...atLarge.filter((m) => m.lead).map((m) => officialItem(m.role, m)));
      const found = await Promise.all(
        council.districts.map(async (l) => ({
          label: l.label,
          value: l.census ? subdivision?.BASENAME : await councilDistrict(l, match.coordinates.x, match.coordinates.y),
        })),
      );
      for (const { label, value } of found) {
        const members = council.members.filter((m) => value && m.district && sameDistrict(m.district, value));
        if (!members.length) continue;
        const name = districtName(members[0].district!, label);
        localItems.push(...members.map((m) => officialItem(`${m.role}, ${name}`, m)));
        // A bare "District 6" could be anything on this line, so a numbered district carries the body's name.
        localWhere.push(label === 'District' && /^\d+$/.test(members[0].district!) ? `${council.body} ${name}` : name);
      }
      localItems.push(...atLarge.filter((m) => !m.lead).map((m) => officialItem(m.role, m)));
    }

    const tiers = $('[data-tiers]');
    tiers.replaceChildren(
      ...[tier('National', national), tier('State', stateItems), tier('Local', localItems)].filter((t): t is HTMLElement => !!t),
    );

    const where = [
      cd && abbr && district ? (district === '0' ? `${abbr} at-large congressional district` : `${abbr}'s ${ordinal(+district)} Congressional District`) : null,
      upper?.NAME,
      fips === '51' ? lower?.NAME?.replace('State House', 'House of Delegates') : lower?.NAME,
      ...(localWhere.length ? localWhere : [incPlace?.BASENAME]),
    ].filter(Boolean);
    $('[data-districts]').textContent = `${match.matchedAddress}: ${where.join(', ')}`;
    $('[data-coverage]').hidden = !!legislature;
    // Not covered yet: offer to ask for the city or county (never the address itself). A covered state with an
    // uncovered locality gets its own note; an uncovered state gets the general one above.
    const localName = incPlace?.BASENAME ?? county?.NAME;
    $('[data-local-name]').textContent = localName ?? '';
    $('[data-local-coverage]').hidden = !legislature || localPlaces.length > 0 || !localName;
    const askFor = [localName ?? state?.NAME, abbr].filter(Boolean).join(', ');
    for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-ask]'))
      a.href = `mailto:places@whatdidgovtdofor.you?subject=${encodeURIComponent(`Please add ${askFor}`)}`;

    // Ways in for the same places: /your-turn/ narrowed by the place ids, never the address. The call to action at
    // the bottom of the page follows suit.
    const nearest = localPlaces[0] ?? index.places.find((p) => p.kind === 'state' && mine.has(p.id));
    $('[data-turn-where]').textContent = nearest ? ` in ${nearest.name}` : '';
    for (const a of document.querySelectorAll<HTMLAnchorElement>('a[href^="/your-turn/"]')) a.href = `/your-turn/?places=${[...mine].join(',')}`;
    officialsEl.hidden = false;

    // Actions that apply to this address.
    let shown = 0;
    for (const section of document.querySelectorAll<HTMLElement>('[data-level-section]')) {
      let any = false;
      for (const li of section.querySelectorAll<HTMLElement>('li[data-places]')) {
        const applies = li.dataset.places!.split(' ').some((p) => mine.has(p));
        li.hidden = !applies;
        if (applies) {
          any = true;
          shown++;
        }
      }
      section.hidden = !any;
    }
    resultsEl.hidden = false;
    statusEl.textContent = `${shown} action${shown === 1 ? '' : 's'} on record for this address.`;
  }

  function fromUrl() {
    const query = new URLSearchParams(location.search).get('address');
    if (query) {
      // Move a no-JS form submission into the fragment so the address isn't kept in the URL sent to servers.
      history.replaceState(null, '', `/you/#${encodeURIComponent(query)}`);
      return query;
    }
    return location.hash.length > 1 ? decodeURIComponent(location.hash.slice(1)) : '';
  }

  const initial = fromUrl();
  if (initial) lookup(initial);
  addEventListener('hashchange', () => {
    const a = fromUrl();
    if (a) lookup(a);
  });
</script>

<style>
  .ask {
    margin-inline: calc(-1 * var(--gutter));
    padding: 1.25rem var(--gutter) 1.75rem;
    background: var(--orange);
  }
  .ask .face {
    max-width: 44rem;
  }
  h1 {
    margin-bottom: 1.25rem;
    font-size: clamp(var(--t-2xl), 7vw, var(--t-4xl));
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .status {
    margin-top: 1.5rem;
    font-weight: 700;
    font-size: var(--t-md);
  }
  .status:empty {
    display: none;
  }
  .officials {
    margin-top: 2.5rem;
  }
  h2 {
    font-size: clamp(var(--t-lg), 4vw, var(--t-xl));
  }
  .districts {
    margin-top: 0.5rem;
    font-weight: 600;
    color: var(--muted);
  }
  .tiers {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .tiers :global(.tier) {
    border: 3px solid var(--ink);
  }
  .tiers :global(h3) {
    padding: 0.85rem 1rem 0.3rem;
    font: 700 1rem / 1.3 var(--text);
  }
  .tiers :global(ul) {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0 1rem 1rem;
    list-style: none;
  }
  .tiers :global(li) {
    display: grid;
  }
  .tiers :global(.title) {
    font-size: 1rem;
    font-weight: 600;
    color: var(--muted);
  }
  .tiers :global(.name) {
    font: 400 var(--t-lg) / 1.2 var(--display);
    text-decoration: none;
  }
  .tiers :global(a.name:hover) {
    text-decoration: underline;
  }
  .tiers :global(.record) {
    font-weight: 700;
    font-size: 1rem;
  }
  .tiers :global(.record.none) {
    font-weight: 500;
    color: var(--muted);
  }
  .coverage {
    margin-top: 1rem;
    font-size: var(--t-body);
    max-width: var(--measure);
  }
  .turn {
    margin-top: 1.25rem;
  }
  .turn a {
    display: inline-block;
    padding: 0.6rem 0;
    font-weight: 700;
    font-size: var(--t-md);
    line-height: 1.3;
    text-decoration-thickness: 2px;
  }
  .results section {
    margin-top: 3.5rem;
  }
  .results h2 {
    margin-bottom: 1.25rem;
  }
</style>
