---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="gone">
    <div class="wrap">
      <h1>Nothing here</h1>
      <p>There's no page at this address. It may have moved, or the action may have been retracted.</p>
      <p><a href="/">Go to the home page</a> or <a href="/actions/">browse all actions</a>.</p>
    </div>
  </div>
</Base>

<style>
  .gone {
    padding: 2rem 0 3rem;
    background: var(--orange);
  }
  h1 {
    font-size: clamp(var(--t-3xl), 9vw, var(--t-6xl));
    letter-spacing: -0.02em;
  }
  p {
    margin-top: 0.75rem;
    font-weight: 600;
    font-size: var(--t-md);
    max-width: 44ch;
  }
</style>
