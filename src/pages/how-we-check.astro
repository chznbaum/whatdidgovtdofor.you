---
import Base from '../layouts/Base.astro';
import { getEntries } from '../lib/data.ts';
import { STATUS_LABEL } from '../lib/status.ts';

const entries = await getEntries();
const verified = entries.filter((e) => e.data.verification.verdict === 'pass' || e.data.verification.verdict === 'corrected').length;

const legend = [
  { tone: 'guide', label: STATUS_LABEL['in-effect'], text: 'Working now, or a one-time benefit that was delivered. Green, like a guide sign.' },
  { tone: 'work', label: STATUS_LABEL['phasing-in'], text: 'Enacted and rolling out. Not everyone has it yet. Orange, like a work zone.' },
  { tone: 'warning', label: STATUS_LABEL['under-threat'], text: 'In effect, but a specific effort would end or gut it. We name the effort. Yellow, like a warning sign.' },
  { tone: 'stop', label: 'Ended', text: 'Repealed, expired, blocked by a court, or cancelled. Red, like a stop sign.' },
];
---

<Base title="How we check" description="How entries are chosen, written, verified, and corrected.">
  <div class="wrap">
    <h1>How we check</h1>

    <div class="cols">
      <div class="prose">
        <p>
          Every sign on this site is one thing government actually did: a law, an executive order, a rule, a budget item, a
          program, or a local ordinance. We don't include proposals, bills that passed only one chamber, or ceremonial
          resolutions. If it isn't enacted, signed, funded, or ordered, it isn't here.
        </p>

        <h2>Where entries come from</h2>
        <p>
          Wherever possible we start from official data instead of searching the web: enacted laws from Congress.gov, the
          Federal Register, state legislative records, city council records, and official press releases. Legislator
          rosters come from the public-domain <a href="https://github.com/unitedstates/congress-legislators"
            >congress-legislators</a
          > project and from <a href="https://openstates.org">Open States</a>.
        </p>

        <h2>Two models from two companies</h2>
        <p>
          An AI model drafts each entry against our <a href="/content-guide/">content guide</a>: plain-language
          headline, who benefits, the numbers, who made it happen, the vote, the current status, and sources. A model
          from a <em>different company</em> then checks every claim against those sources. If Claude (Anthropic) wrote it,
          GPT (OpenAI) checks it, and the other way around. The checker can pass the entry, correct it, or fail it. Failed
          entries don't appear on the site.
        </p>
        <p>
          Each entry's page says which models wrote and checked it, and when. Right now {verified} of {entries.length}
          entries have had their second check. Entries still waiting say so.
        </p>

        <h2>Credit where it's due</h2>
        <p>
          We name the people who made each action happen and show their party. When Republicans deliver something good for
          people, we say so just as plainly as we do for Democrats. For legislation, we show the official roll call broken
          down by party.
        </p>

        <h2>Status changes</h2>
        <p>
          Laws get repealed, programs get defunded, and courts block rules. Every entry shows its status as of the date we
          last checked, and when something is under threat or has ended, we say who did it and link the evidence.
        </p>

        <h2>Corrections</h2>
        <p>
          If something is wrong or missing, <a href="mailto:corrections@whatdidgovtdofor.you">send a correction</a>.
          Retracted entries are removed and won't be re-added automatically.
        </p>

        <h2>Your address</h2>
        <p>
          When you look up your address, your browser sends it directly to the U.S. Census Bureau's public geocoder to find
          your districts. It never reaches our servers, and we don't store it.
        </p>
      </div>

      <aside aria-labelledby="legend-h">
        <h2 id="legend-h">What the colors mean</h2>
        <ul role="list">
          {
            legend.map((l) => (
              <li>
                <span class="chip" data-tone={l.tone}>
                  <span>{l.label}</span>
                </span>
                <p>{l.text}</p>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>
</Base>

<style>
  h1 {
    margin-top: 1.5rem;
    font-size: clamp(var(--t-xl), 7vw, var(--t-3xl));
  }
  .cols {
    display: grid;
    gap: 3rem;
    margin-top: 2rem;
  }
  @media (min-width: 62rem) {
    .cols {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: 4rem;
    }
    aside {
      position: sticky;
      top: 1.5rem;
      align-self: start;
    }
  }
  .prose h2 {
    margin: 2.25rem 0 0.6rem;
    font-size: var(--t-md);
  }
  aside h2 {
    margin-bottom: 1rem;
    font-size: var(--t-md);
  }
  aside ul {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  aside p {
    margin-top: 0.4rem;
    font-family: var(--serif);
  }
  .chip {
    display: inline-block;
    padding: 4px;
    border-radius: 10px;
  }
  .chip span {
    display: block;
    padding: 0.3rem 0.75rem 0.15rem;
    border: 3px solid;
    border-radius: 7px;
    font-weight: 800;
  }
  .chip[data-tone='guide'] {
    background: var(--guide);
    color: var(--paper);
  }
  .chip[data-tone='work'] {
    background: var(--work);
  }
  .chip[data-tone='warning'] {
    background: var(--warning);
  }
  .chip[data-tone='stop'] {
    background: var(--stop);
    color: var(--paper);
  }
</style>
